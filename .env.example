# ==========================================
# Cold Outreach Personaliser Environment Config
# ==========================================

# Anthropic Claude API (Used for Anti-AI cold email generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LangSmith Observability & Evaluation Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=cold-outreach-personaliser
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Model Configuration (claude-3-5-sonnet-20241022 or claude-3-haiku-20240307)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# MongoDB Database URI (Defaults to localhost, automatic in-memory fallback enabled if offline)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=cold_outreach_db

# Web Search / Enrichment Tool (Optional for live prospect company context)
TAVILY_API_KEY=

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_987654321
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Port
PORT=8000
HOST=0.0.0.0
