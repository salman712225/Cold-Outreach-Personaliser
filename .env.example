# ==========================================
# Cold Outreach Personaliser Environment Config
# ==========================================

# Mistral AI API Key & Model
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# LangSmith Observability & Evaluation Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=cold-outreach-personaliser
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# MongoDB Database URI (Defaults to localhost or Atlas connection string)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=cold_outreach_db

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_987654321
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server
HOST=0.0.0.0
PORT=8000
